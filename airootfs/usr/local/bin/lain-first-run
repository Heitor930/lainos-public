#!/usr/bin/env bash
# ‡ LainOS — primeira entrada na sessão.
set -u

# Na ISO ao vivo: sempre abre as boas-vindas (é lá que está o botão de instalar)
if [[ -d /run/archiso ]]; then
    sleep 2
    exec lainos-welcome --live
fi

marker="$HOME/.config/lainos/.first-run-done"
[[ -e $marker ]] && exit 0
mkdir -p "$(dirname "$marker")"
touch "$marker"

sleep 2
setsid -f lainos-welcome >/dev/null 2>&1

# Deixa o Hermes baixado em segundo plano para já estar lá quando você for
# configurar. Para não baixar: touch ~/.config/lainos/no-hermes antes do primeiro login.
if [[ ! -e "$HOME/.config/lainos/no-hermes" ]]; then
    (
        for _ in $(seq 1 30); do
            if curl -fsI --max-time 8 https://hermes-agent.nousresearch.com/install.sh >/dev/null 2>&1; then
                lain-hermes-install --quiet
                break
            fi
            sleep 20
        done
    ) &
    disown
fi
exit 0
