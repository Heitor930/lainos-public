# ‡ LainOS — animação de inicialização: emblema no centro, pulsando devagar.
# Para trocar a imagem: substitua logo.png (e wordmark.png) nesta pasta e rode
#   sudo mkinitcpio -P

Window.SetBackgroundTopColor(0.031, 0.035, 0.031);
Window.SetBackgroundBottomColor(0.031, 0.035, 0.031);

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();

logo.image = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetX() + screen_w / 2 - logo.image.GetWidth() / 2;
logo.y = Window.GetY() + screen_h / 2 - logo.image.GetHeight() / 2 - 40;
logo.sprite.SetPosition(logo.x, logo.y, 10);

word.image = Image("wordmark.png");
word.w = Math.Min(word.image.GetWidth(), screen_w * 0.5);
word.h = word.image.GetHeight() * (word.w / word.image.GetWidth());
word.scaled = word.image.Scale(word.w, word.h);
word.sprite = Sprite(word.scaled);
word.sprite.SetPosition(Window.GetX() + screen_w / 2 - word.w / 2,
                        logo.y + logo.image.GetHeight() + 28, 10);
word.sprite.SetOpacity(0.7);

tick = 0;
fun refresh_callback() {
    tick++;
    logo.sprite.SetOpacity(0.74 + 0.26 * Math.Sin(tick / 24));
}
Plymouth.SetRefreshFunction(refresh_callback);

fun quit_callback() {
    logo.sprite.SetOpacity(1);
}
Plymouth.SetQuitFunction(quit_callback);

# Mensagens do sistema (por exemplo, checagem de disco) aparecem discretas embaixo
message_sprite = Sprite();
fun display_message_callback(text) {
    image = Image.Text(text, 0.64, 0.66, 0.61);
    message_sprite.SetImage(image);
    message_sprite.SetPosition(Window.GetX() + screen_w / 2 - image.GetWidth() / 2,
                               Window.GetY() + screen_h * 0.88, 20);
}
Plymouth.SetDisplayMessageFunction(display_message_callback);
