# ‡ LainOS — plano B do primeiro início: criação da conta em modo texto no
# terminal 2, caso o assistente gráfico não abra. Some depois que a conta existe.
[Unit]
Description=LainOS: primeiro início em modo texto (tty2)
ConditionPathExists=/var/lib/lainos/firstboot
After=systemd-user-sessions.service plymouth-quit-wait.service
Conflicts=getty@tty2.service
Before=getty@tty2.service

[Service]
Type=idle
ExecStart=/usr/lib/lainos/firstboot-console
StandardInput=tty
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
Restart=no

[Install]
WantedBy=multi-user.target
