/* Seletor de papel de parede: grade de miniaturas */
@import "lainos"

window {
    width: 940px;
}
listview {
    columns: 3;
    lines: 3;
    spacing: 10px;
    flow: horizontal;
}
element {
    orientation: vertical;
    padding: 10px;
    spacing: 8px;
}
element-icon {
    size: 150px;
    horizontal-align: 0.5;
}
element-text {
    horizontal-align: 0.5;
    font: "JetBrainsMono Nerd Font 9";
}
