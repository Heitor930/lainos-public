// ‡ LainOS — fastfetch (as informações que aparecem ao abrir o terminal)
// Arte: ~/.config/fastfetch/logo.txt (texto). Para usar uma imagem sua no
// lugar: `lain-style terminal-art /caminho/da/imagem.png`
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/logo.txt",
        "color": { "1": "38;2;138;154;91" },
        "padding": { "top": 1, "left": 2, "right": 4 }
    },
    "display": {
        "separator": "  ",
        "color": { "keys": "38;2;138;154;91", "title": "38;2;232;234;228" },
        "key": { "width": 11 }
    },
    "modules": [
        "break",
        "title",
        { "type": "custom", "format": "\u001b[38;2;61;74;36m──────────────────────────────\u001b[0m" },
        { "type": "os", "key": "distro" },
        { "type": "kernel", "key": "kernel" },
        { "type": "packages", "key": "pacotes" },
        { "type": "wm", "key": "janelas" },
        { "type": "shell", "key": "shell" },
        { "type": "terminal", "key": "terminal" },
        "break",
        { "type": "host", "key": "máquina" },
        { "type": "cpu", "key": "cpu" },
        { "type": "gpu", "key": "vídeo" },
        { "type": "memory", "key": "memória" },
        { "type": "disk", "key": "disco", "folders": "/" },
        { "type": "display", "key": "tela" },
        { "type": "uptime", "key": "ligado há" },
        "break",
        { "type": "colors", "symbol": "circle", "paddingLeft": 0 }
    ]
}
